{
  "name": "agrofield-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:android": "tsc && vite build --mode native",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "@types/leaflet": "^1.9.21",
    "dexie": "^4.4.2",
    "leaflet": "^1.9.4",
    "marked": "^14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "baseline-browser-mapping": "^2.10.17",
    "brace-expansion": "^5.0.12",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch@9.0.9": {
      "brace-expansion": "^5.0.8"
    },
    "minimatch@>=10": {
      "brace-expansion": "^5.0.8"
    }
  }
}
